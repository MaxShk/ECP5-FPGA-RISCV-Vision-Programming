
#PLL/CLOCK
FREQUENCY PORT "clk_board" 25.0MHZ;
LOCATE COMP "clk_board" SITE "TBD";
IOBUF PORT "clk_board" IO_TYPE=LVCMOS33;

#UART PINS
LOCATE COMP "uart_tx" SITE "TBD";
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;

LOCATE COMP "uart_rx" SITE "TBD";
IOBUF PORT "uart_rx" IO_TYPE=LVCMOS33;


#LOW SPEED GPIO
LOCATE COMP "gpio_21_p" SITE "TBD";
IOBUF PORT "gpio_21_p" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "gpio_21_n" SITE "TBD";
IOBUF PORT "gpio_21_n" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;


LOCATE COMP "gpio_22a" SITE "TBD";
IOBUF PORT "gpio_22a" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "gpio_22b" SITE "TBD";
IOBUF PORT "gpio_22b" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;


LOCATE COMP "gpio_24a" SITE "TBD";
IOBUF PORT "gpio_24a" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "gpio_24b" SITE "TBD";
IOBUF PORT "gpio_24b" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;


LOCATE COMP "gpio_26a" SITE "TBD";
IOBUF PORT "gpio_26a" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "gpio_26b" SITE "TBD";
IOBUF PORT "gpio_26b" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "gpio_27a" SITE "TBD";
IOBUF PORT "gpio_27a" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;

LOCATE COMP "gpio_27b" SITE "TBD";
IOBUF PORT "gpio_27b" IO_TYPE=LVCMOS33 DRIVE=4 SLEWRATE=SLOW;
